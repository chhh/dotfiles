# -*- mode: gitconfig; -*-
# vim: set filetype=gitconfig:
[alias]
  # List the branches (local and remote-tracking) already merged into a base: the ones safe to clean up.
  # Usage: git merged [options] [base]        base defaults to the current branch (or e.g. origin/main)
  #   -s, --skip-same     also skip branches whose tip IS the base's commit (a fresh branch with no
  #                       commits of its own counts as merged otherwise)
  #   -e, --exclude RE    skip branches whose name matches the extended regex RE; repeatable
  #   --since DATE        only branches whose LAST commit is on or after DATE (inclusive)
  #   --before DATE       only branches whose LAST commit is before DATE (exclusive); both together
  #                       select a range [since, before). YYYY-MM-DD, a prefix like 2026-09 works.
  #                       The same two options as list-nonmerged.
  #   -d, --dates         print "<last-commit-date> <branch>" instead of just the name
  #   -n, --no-fetch      do not run `git fetch --all --prune` first (it is on by default)
  # The base itself is never listed, nor its copy on any remote (origin/dev, upstream/dev, ...),
  # nor any <remote>/HEAD. Newest last commit first.
  #
  # Examples:
  #   git merged                                      # merged into the current branch
  #   git merged -s                                   # ...without the same-commit ones
  #   git merged -e '(^|/)main$'                      # ...without main and origin/main, upstream/main, ...
  #   git merged -e '(^|/)main$' -e '^release/'       # several exclusions
  #   git merged --before 2026-09-01 -d               # merged, last commit before Sep 1, with dates
  #   git merged --since 2026-08 --before 2026-09     # merged, last commit in August
  #   git merged -n -s --before 2026-09 origin/main   # merged into origin/main, no fetch
  merged = "!f() { \
    base=; same=; since=; before=; excl=; dates=; fetch=1; \
    while [ $# -gt 0 ]; do \
      case $1 in \
        -s|--skip-same) same=1;; \
        -d|--dates) dates=1;; \
        -n|--no-fetch) fetch=;; \
        --since|--before|-e|--exclude) \
          [ $# -ge 2 ] || { echo \"merged: $1 needs a value\"; exit 2; }; \
          case $1 in --since) since=$2;; --before) before=$2;; *) excl=\"${excl:+$excl|}($2)\";; esac; shift;; \
        -*) echo \"merged: unknown option $1\"; exit 2;; \
        *) base=$1;; \
      esac; shift; \
    done; \
    base=${base:-$(git rev-parse --abbrev-ref HEAD)}; \
    git rev-parse --verify -q \"$base^{commit}\" >/dev/null || { echo \"merged: unknown base: $base (dates go in --since / --before)\"; exit 2; }; \
    [ -z \"$fetch\" ] || git fetch --all --prune -q; \
    n=$base; for r in $(git remote); do case $base in $r/*) n=${base#$r/};; esac; done; \
    ex=\"HEAD $n\"; for r in $(git remote); do ex=\"$ex $r $r/HEAD $r/$n\"; done; \
    tip=; [ -z \"$same\" ] || tip=$(git rev-parse \"$base^{commit}\"); \
    git for-each-ref --merged=\"$base\" --sort=-committerdate --format='%(committerdate:short) %(refname:short) %(objectname)' refs/heads refs/remotes \
      | EX=\"$ex\" SINCE=\"$since\" BEFORE=\"$before\" TIP=\"$tip\" RE=\"$excl\" DATES=\"$dates\" awk 'BEGIN { n = split(ENVIRON[\"EX\"], a, \" \"); for (i = 1; i <= n; i++) x[a[i]] = 1; re = ENVIRON[\"RE\"]; since = ENVIRON[\"SINCE\"]; before = ENVIRON[\"BEFORE\"]; tip = ENVIRON[\"TIP\"]; dates = ENVIRON[\"DATES\"] } \
        $2 in x { next } \
        length(since) && $1 < since { next } \
        length(before) && $1 >= before { next } \
        length(tip) && $3 == tip { next } \
        length(re) && $2 ~ re { next } \
        { if (length(dates)) print $1, $2; else print $2 }'; \
  }; f"

  # Fast forward all branches that have a remote and are trivially fast-forwardable
  ff-all = "!f() { \
    git fetch --all --prune && \
    for b in $(git for-each-ref --format='%(refname:short)' refs/heads/); do \
      u=$(git for-each-ref --format='%(upstream:short)' refs/heads/$b); \
      if [ -n \"$u\" ] && git merge-base --is-ancestor $b $u; then \
        git branch -f \"$b\" \"$u\" && \
        echo \"Fast-forwarded $b → $u\"; \
      fi; \
    done; \
  }; f"

  # Dry-run: Fast forward all branches that have a remote and are trivially fast-forwardable
  ff-all-dry = "!f() { \
    git fetch --all --prune && \
    for b in $(git for-each-ref --format='%(refname:short)' refs/heads/); do \
      u=$(git for-each-ref --format='%(upstream:short)' refs/heads/$b); \
      if [ -n \"$u\" ] && git merge-base --is-ancestor $b $u; then \
        if [ \"$(git rev-parse $b)\" != \"$(git rev-parse $u)\" ]; then \
          echo \"Would fast-forward $b → $u\"; \
        fi; \
      fi; \
    done; \
  }; f"


  # Worktree stuff
  wt = worktree
  wtl = wt list

  wt-rm = "!f(){ wt=\"$1\"; [ -z \"$wt\" ] && { echo \"usage: git wt-rm <worktree-path>\"; exit 2; }; [ \"$wt\" = \".\" ] && { echo \"refusing to remove .\"; exit 2; }; [ \"$wt\" = \"/\" ] && { echo \"refusing to remove /\"; exit 2; }; if git -C \"$wt\" rev-parse --is-inside-work-tree >/dev/null 2>&1; then git -C \"$wt\" submodule deinit -f --all >/dev/null 2>&1 || true; fi; git worktree remove -f \"$wt\" >/dev/null 2>&1 && exit 0; rm -rf \"$wt\"; git worktree prune; }; f"
  # Print short git hash of the last commit

  lasthash = rev-parse --short HEAD


  # Moving branches quickly without checkout

  # Move user-provided branch name to HEAD
  mp = "!f() { git merge $1; git push; }; f"
  mh = "!f() { git fetch . HEAD:$1; }; f"
  mhp = "!f() { git fetch . HEAD:$1 && git push origin $1; }; f"
  mmh = "!f() { git fetch . HEAD:main; }; f"
  mmhp = "!f() { git fetch . HEAD:main && git push origin main; }; f"
  mdhp = "!f() { git fetch . HEAD:dev && git push origin dev; }; f"


  # Delete remote branch, allowing remotes/origin in the branch name
  # Use case: you copied a remote branch name from gitk - this function can take it
  delete-remote = "!f() { \
    stripped=\"${1#remotes/}\"; \
    remote=\"${stripped%%/*}\"; \
    replaced=\"${stripped#*/}\"; \
    echo \"executing: git push -d $remote $replaced\"; \
    git push -d \"$remote\" \"$replaced\"; \
  }; f"

  # alternative push -d origin using shell string substitution:
  delete-remote-alt = "!f() { git push -d origin \"${1#remotes/*/}\"; }; f"

  # short alias for delete-remote
  del = delete-remote

  cot = !git checkout --track
  push-init = !git push -u origin `git branch --show-current`
  push-init-to = "!f() { git push -u $1 `git branch --show-current`; }; f"
  push-force = !git push -fu
  menff = merge --no-ff

  # merge remote branch into current, allowing remotes/ or origin/ prefix to be omitted
  merge-remote = "!f() { \
    replaced=$(echo "$1" | awk '{gsub(/^remotes\\/[^\\/]*\\//, \"\")}{print}'); \
    replaced=$(echo "$replaced" | awk '{gsub(/^origin\\//, \"\")}{print}'); \
    replaced="origin/$replaced"; \
    echo "executing: merge $replaced"; \
    git merge --no-ff "$replaced"; \
  }; f"

  # detach HEAD
  detach = checkout --detach

  # detach HEAD and delete the branch we were on (local only)
  detach-delete-local = "!f() { \
    cur=$(git branch --show-current); \
    echo "deleting branch: $cur"; \
    git checkout --detach; \
    git branch -d $cur; \
  }; f"

  # detach (if needed), delete branch locally, and delete it from every
  # remote it actually exists on. Takes an optional branch name; defaults
  # to the current branch.
  # Optional leading -f force-deletes locally (git branch -D).
  detach-delete-all = "!f() { \
    D=-d; \
    if [ \"$1\" = -f ]; then D=-D; shift; fi; \
    BRANCH=${1:-$(git branch --show-current)}; \
    if [ "$BRANCH" = "$(git branch --show-current)" ]; then \
      git checkout --detach; \
    fi; \
    git branch $D "$BRANCH"; \
    for remote in $(git remote); do \
      if git ls-remote --exit-code --heads "$remote" "$BRANCH" >/dev/null 2>&1; then \
        echo "deleting $BRANCH from $remote"; \
        git push "$remote" --delete "$BRANCH"; \
      fi; \
    done; \
  }; f"

  dda = detach-delete-all

  switch-del = "!f() { \
    F=; \
    if [ \"$1\" = -f ]; then F=-f; shift; fi; \
    [ -n \"$1\" ] || { echo 'usage: git switch-del [-f] <new-branch-name>'; exit 2; }; \
    git detach-delete-all $F && \
    git switch -c \"$1\"; \
  }; f"

  # Merge current branch into dev without checking out dev
  # Then fast forward current branch to the merge commit
  # Push both to origin
  mdev = "!f() { \
    set -e; \
    b=$(git symbolic-ref --short HEAD); \
    [ \"$b\" != dev ] || { echo 'mdev: run it from the feature branch'; exit 1; }; \
    git diff --quiet && git diff --cached --quiet || { echo 'mdev: commit or stash first'; exit 1; }; \
    git fetch origin --prune; \
    if ! out=$(git merge-tree --write-tree --name-only origin/dev \"$b\"); then \
            echo \"mdev: $b conflicts with origin/dev, nothing changed. Conflicted files:\"; \
            echo \"$out\" | tail -n +2; exit 1; \
    fi; \
    tree=$(echo \"$out\" | head -n 1); \
    m=$(git commit-tree \"$tree\" -p origin/dev -p \"$b\" -m \"Merge branch '$b' into dev\"); \
    git push origin \"$m:refs/heads/dev\"; \
    git branch -f dev \"$m\" 2>/dev/null || echo 'mdev: local dev not moved (checked out in another worktree?)'; \
    git merge --ff-only --quiet \"$m\"; \
    git push origin \"$b\"; \
  }; f"


  # List branches NOT merged into a base (default: the current branch), newest first, each with
  # the date of its last commit. Local and remote together, or either one. The merge-*-nonmerged
  # and rebase-merge-*-nonmerged aliases below are built on it and pass their options through.
  #
  # Usage: git list-nonmerged [options] [base]
  #   --since DATE    only branches whose LAST commit is on or after DATE (inclusive)
  #   --before DATE   only branches whose LAST commit is before DATE (exclusive)
  #                   Both together select a range [since, before). DATE is YYYY-MM-DD; a prefix
  #                   like 2026-10 works: --since 2026-10 = from Oct 1, --before 2026-10 = up to
  #                   the end of September. `git merged` takes the same two options.
  #   -l, --local     local branches only
  #   -r, --remote    remote-tracking branches only (default: both)
  #   base            what "merged" means: a branch counts as not merged when its tip is not in
  #                   this. Default HEAD. Any ref works, e.g. origin/dev.
  # Remote results are only as fresh as the last `git fetch`. <remote>/HEAD is left out.
  # Output is "<date> <branch>"; for just the names: git list-nonmerged ... | awk '{print $2}'
  #
  # Examples:
  #   git list-nonmerged                                      # everything not in HEAD
  #   git list-nonmerged --since 2026-10                      # ...with a last commit since Oct 1
  #   git list-nonmerged --since 2026-09 --before 2026-10     # ...during September
  #   git list-nonmerged -r --before 2026-09 origin/dev       # remote only, older than Sep 1, not in origin/dev
  #   git list-nonmerged -l                                   # local only
  list-nonmerged = "!f() { \
    since=; before=; scope='refs/heads refs/remotes'; base=HEAD; \
    while [ $# -gt 0 ]; do \
      case $1 in \
        --since|--before) \
          [ $# -ge 2 ] || { echo \"list-nonmerged: $1 needs a value\"; exit 2; }; \
          case $1 in --since) since=$2;; *) before=$2;; esac; shift;; \
        -l|--local) scope=refs/heads;; \
        -r|--remote) scope=refs/remotes;; \
        -*) echo \"list-nonmerged: unknown option $1\"; exit 2;; \
        *) base=$1;; \
      esac; shift; \
    done; \
    git rev-parse --verify -q \"$base^{commit}\" >/dev/null || { echo \"list-nonmerged: unknown base: $base (dates go in --since / --before)\"; exit 2; }; \
    git for-each-ref --no-merged=\"$base\" --sort=-committerdate --format='%(committerdate:short) %(refname:short)' $scope \
      | EX=\"$(git remote | tr '\\n' ' ')\" SINCE=\"$since\" BEFORE=\"$before\" awk 'BEGIN { n = split(ENVIRON[\"EX\"], a, \" \"); for (i = 1; i <= n; i++) x[a[i]] = 1; since = ENVIRON[\"SINCE\"]; before = ENVIRON[\"BEFORE\"] } \
        $2 in x || $2 ~ /HEAD$/ { next } \
        length(since) && $1 < since { next } \
        length(before) && $1 >= before { next } \
        { print }'; \
  }; f"

  # Merge every LOCAL branch not yet merged into the current one, one --no-ff merge commit each.
  # Usage: git merge-local-nonmerged [--since DATE] [--before DATE]   (the options of list-nonmerged, passed on)
  # The branches come from `git list-nonmerged --local ...` (newest commit first) and
  # are merged in that order. Stops at the first conflict (non-zero exit), leaving that merge in
  # progress and the earlier ones done. Resolve it and `git commit --no-edit` (or
  # `git merge --abort`), then run it again: merged branches drop out of the list, so it carries on.
  merge-local-nonmerged = "!f() { \
    for b in $(git list-nonmerged --local \"$@\" | awk '{print $2}'); do \
      echo \"merge-local-nonmerged: $b\"; \
      git merge --no-ff --no-edit \"$b\" || exit 1; \
    done; \
  }; f"

  # Same for REMOTE-tracking branches: merges origin/<name> etc. into the current branch.
  # Usage: git merge-remote-nonmerged [--since DATE] [--before DATE]. Fetch first (git fa) for fresh results.
  # Merge commits read "Merge remote-tracking branch 'origin/x'". Stops at the first conflict; to
  # continue, same as merge-local-nonmerged. The remote branches are untouched, so once you push
  # the current branch they count as merged and drop off the list.
  merge-remote-nonmerged = "!f() { \
    for b in $(git list-nonmerged --remote \"$@\" | awk '{print $2}'); do \
      echo \"merge-remote-nonmerged: $b\"; \
      git merge --no-ff --no-edit \"$b\" || exit 1; \
    done; \
  }; f"

  # merge-remote-nonmerged, then fast-forward those remote branches to the new tip, so they end up
  # level with the current branch. Usage: git merge-ff-remote-nonmerged [--since DATE] [--before DATE]
  # Steps: remember the branches `git list-nonmerged --remote ...` gives, merge them
  # all (stops on the first conflict: nothing is pushed, resolve and rerun), `git push` the
  # current branch, then push its tip to each remote branch. The branch pushes are plain
  # fast-forwards (the current branch now contains each of them), never forced: if someone moved
  # one meanwhile, that push is rejected, reported, and the rest still go. Pushing the current
  # branch first means a rejected push there stops everything before any other branch moves.
  # Needs an upstream on the current branch. Every listed remote branch becomes a copy of the
  # current branch, including the other branches' work: other people's branches are moved.
  merge-ff-remote-nonmerged = "!f() { \
    git symbolic-ref -q HEAD >/dev/null || { echo 'merge-ff-remote-nonmerged: detached HEAD, switch to a branch'; exit 1; }; \
    branches=$(git list-nonmerged --remote \"$@\" | awk '{print $2}'); \
    [ -n \"$branches\" ] || { echo 'merge-ff-remote-nonmerged: no non-merged remote branches'; exit 0; }; \
    git merge-remote-nonmerged \"$@\" || exit 1; \
    git push || { echo 'merge-ff-remote-nonmerged: push of the current branch failed, remote branches left alone'; exit 1; }; \
    failed=; \
    for r in $branches; do \
      echo \"merge-ff-remote-nonmerged: fast-forward $r\"; \
      git push -q \"${r%%/*}\" \"HEAD:refs/heads/${r#*/}\" || failed=\"$failed $r\"; \
    done; \
    [ -z \"$failed\" ] || { echo \"merge-ff-remote-nonmerged: could not fast-forward:$failed\"; exit 1; }; \
  }; f"

  # Rebase, then merge, every LOCAL branch not yet merged into the current one: each branch is
  # first rebased onto the current branch, then merged with --no-ff, one branch at a time. Each
  # rebase starts from the previous merge, so the history reads as a clean sequence of "branch,
  # merge commit, branch, merge commit" with no criss-crossing.
  # Usage: git rebase-merge-local-nonmerged [--since DATE] [--before DATE]. Refuses a detached HEAD or a dirty tree;
  # stops on the first failure.
  # REWRITES the rebased branches' commits: one already pushed needs a force-push after.
  # If a rebase conflicts: resolve it, `git rebase --continue`, `git switch <the branch you were
  # on>`, run it again: that branch is already on top, so it only merges, and the rest follow.
  # To give up on it: `git rebase --abort`.
  rebase-merge-local-nonmerged = "!f() { \
    cur=$(git symbolic-ref --short -q HEAD) || { echo 'rebase-merge-local-nonmerged: detached HEAD, switch to a branch'; exit 1; }; \
    git diff --quiet && git diff --cached --quiet || { echo 'rebase-merge-local-nonmerged: commit or stash first'; exit 1; }; \
    for b in $(git list-nonmerged --local \"$@\" | awk '{print $2}'); do \
      echo \"rebase-merge-local-nonmerged: $b onto $cur\"; \
      git rebase \"$cur\" \"$b\" || { echo \"rebase of $b stopped: resolve, git rebase --continue, git switch $cur, rerun\"; exit 1; }; \
      git switch -q \"$cur\" && git merge --no-ff --no-edit \"$b\" || { echo \"merge of $b failed\"; exit 1; }; \
    done; \
  }; f"

  # Rebase, then merge, the remote branches YOU NAME, one at a time, in the order given.
  # Usage: git rebase-merge-remote-branches [--push] <branch>...
  #   git rebase-merge-remote-branches remotes/origin/feat/self-ion-scan remotes/origin/feat/plug-align
  # Names may be pasted from gitk (remotes/origin/x) or written origin/x; all are checked first, so
  # a typo stops the run before anything changes. Each branch is rebased onto the current branch,
  # then merged with --no-ff ("Merge branch 'x' into <current>"), and the next rebase starts from
  # that merge: a clean ladder of "branch, merge commit" in gitk, no criss-crossing.
  # The catch with REMOTE branches: one cannot be rebased in place. Each is rebased as a detached
  # copy and that copy is merged. The remote branch itself is NOT changed, so after you push, git
  # still lists it as not merged (its commits differ from the rebased copy) until you force-push
  # the rebased tips back to it. Rerunning skips branches whose changes are already in the current
  # branch (`git cherry`), so it is safe to rerun. Refuses a detached HEAD or a dirty tree.
  # It does NOT stop on a conflict: resuming would redo the same rebase from the unchanged remote
  # branch. A conflicting rebase is aborted, that branch is skipped, the rest are processed, and the
  # skipped ones are listed at the end (exit 1). Merge those by hand, resolving the conflict in the
  # merge: git merge --no-ff origin/<name>
  # --push: afterwards also push the rebased tips back, so the remote branches match what was merged
  # and drop off `list-nonmerged`. First a plain `git push` of the current branch (needs an upstream;
  # if it fails nothing else is pushed), then each rebased tip is FORCE-pushed to its remote branch
  # with --force-with-lease pinned to the commit you rebased from: if someone pushed to that branch
  # meanwhile, that one is rejected and reported and the rest still go. Branches skipped (conflict or
  # already in the current branch) are not pushed. This REWRITES the remote branches.
  rebase-merge-remote-branches = "!f() { \
    push=; [ \"$1\" != --push ] || { push=1; shift; }; \
    [ $# -gt 0 ] || { echo 'usage: git rebase-merge-remote-branches [--push] <remote-branch>...  (remotes/origin/x or origin/x)'; exit 1; }; \
    cur=$(git symbolic-ref --short -q HEAD) || { echo 'rebase-merge-remote-branches: detached HEAD, switch to a branch'; exit 1; }; \
    git diff --quiet && git diff --cached --quiet || { echo 'rebase-merge-remote-branches: commit or stash first'; exit 1; }; \
    refs=; \
    for a in \"$@\"; do \
      r=\"${a#remotes/}\"; \
      git rev-parse --verify -q \"refs/remotes/$r\" >/dev/null || { echo \"rebase-merge-remote-branches: no such remote branch: $a\"; exit 1; }; \
      refs=\"$refs $r\"; \
    done; \
    skipped=; failed=; pairs=; \
    for b in $refs; do \
      git cherry \"$cur\" \"$b\" | grep -q '^+' || { echo \"rebase-merge-remote-branches: skip $b (already in $cur)\"; continue; }; \
      echo \"rebase-merge-remote-branches: $b onto $cur\"; \
      old=$(git rev-parse \"refs/remotes/$b\"); \
      git rebase \"$cur\" \"$b\" || { git rebase --abort; echo \"rebase-merge-remote-branches: SKIPPED $b (conflicts with $cur; merge it by hand: git merge --no-ff $b)\"; skipped=\"$skipped $b\"; continue; }; \
      tip=$(git rev-parse HEAD); \
      git switch -q \"$cur\" && git merge --no-ff --no-edit -m \"Merge branch '${b#*/}' into $cur\" \"$tip\" || { echo \"merge of $b failed\"; exit 1; }; \
      pairs=\"$pairs $b:$tip:$old\"; \
    done; \
    if [ -n \"$push\" ] && [ -n \"$pairs\" ]; then \
      git push || { echo 'rebase-merge-remote-branches: push of the current branch failed, remote branches left alone'; exit 1; }; \
      for p in $pairs; do \
        b=${p%%:*}; rest=${p#*:}; tip=${rest%%:*}; old=${rest#*:}; \
        echo \"rebase-merge-remote-branches: force-push $b\"; \
        git push -q --force-with-lease=\"refs/heads/${b#*/}:$old\" \"${b%%/*}\" \"$tip:refs/heads/${b#*/}\" || failed=\"$failed $b\"; \
      done; \
    fi; \
    [ -z \"$failed\" ] || echo \"rebase-merge-remote-branches: could not force-push (changed on the remote?):$failed\"; \
    [ -z \"$skipped$failed\" ] || { [ -z \"$skipped\" ] || echo \"rebase-merge-remote-branches: skipped (conflicts):$skipped\"; exit 1; }; \
  }; f"

  # Same, for every remote branch `git list-nonmerged --remote ...` lists (see
  # rebase-merge-remote-branches above for how it works and its catch).
  # Usage: git rebase-merge-remote-nonmerged [--since DATE] [--before DATE]
  rebase-merge-remote-nonmerged = "!f() { \
    branches=$(git list-nonmerged --remote \"$@\" | awk '{print $2}'); \
    [ -n \"$branches\" ] || { echo 'rebase-merge-remote-nonmerged: no non-merged remote branches'; exit 0; }; \
    git rebase-merge-remote-branches $branches; \
  }; f"

  # rebase-merge-remote-nonmerged, then force-push each rebased tip back to its remote branch (the
  # "force" is in the name because it rewrites other branches). Same as
  # `git rebase-merge-remote-branches --push <the branches git list-nonmerged --remote lists>`:
  # see there for the exact steps, the lease and what is skipped. Afterwards each remote branch holds
  # just its own rebased commits, is an ancestor of the current branch, and drops off list-nonmerged.
  # Needs an upstream on the current branch. Usage: git rebase-merge-force-remote-nonmerged
  # [--since DATE] [--before DATE]. For branches you pick by name, call
  # `git rebase-merge-remote-branches --push <names>` directly.
  rebase-merge-force-remote-nonmerged = "!f() { \
    branches=$(git list-nonmerged --remote \"$@\" | awk '{print $2}'); \
    [ -n \"$branches\" ] || { echo 'rebase-merge-force-remote-nonmerged: no non-merged remote branches'; exit 0; }; \
    git rebase-merge-remote-branches --push $branches; \
  }; f"

  # detach, delete given local branch, checkout fresh remote-tracking
  rebranch = "!f() { \
    BRANCH=${1}; \
    git checkout --detach; \
    git branch -d "$BRANCH"; \
    git cot "origin/$BRANCH"; \
  }; f"

  remaster = rebranch master
  rerelease = rebranch release/2021.09



  mob3d = !gitk --date-order --glob=*MOB* --since=3.days
  mob1w = !gitk --date-order --glob=*MOB* --since=1.week
  mob1m = !gitk --date-order --glob=*MOB* --since=1.month
  mob   = !gitk --date-order --glob=*MOB* --since=1.month
  mob6m = !gitk --date-order --glob=*MOB* --since=6.months

  view-cur = !gitk --since=1.week
  view = !gitk --date-order --all --since=1.week
  view-all = !gitk --date-order --all
  view1d = !gitk --date-order --all --since=1.day
  view3d = !gitk --date-order --all --since=3.days
  view1w = !gitk --date-order --all --since=1.week
  view1m = !gitk --date-order --all --since=1.month
  view3m = !gitk --date-order --all --since=3.months
  view6m = !gitk --date-order --all --since=6.months

  hide = update-index --assume-unchanged
  unhide = update-index --no-assume-unchanged
  unhide-all = ! git ls-files -v | grep '^[a-z]' | cut -c3- | xargs git unhide --
  hidden = ! git ls-files -v | grep '^[a-z]' | cut -c3-

  # template/stub for functional git aliases
  # my_alias = "!f() { 〈your complex command〉 }; f"

  # edit git config with default text editor
  ec = config --global -e

  # run before each commit :)
  pre = diff --cached --diff-algorithm=minimal -w

  # {add all commit message} commit all changed/new files with a message
  # this is the same as 'savem' alias
  aacm = !git add -A && git commit -m

  fa = fetch --all --prune --tags --force
  fp = fetch --prune
  up = !git pull --ff-only --recurse-submodules --autostash --prune --tags --force $@ && git submodule update --init --recursive
  add-subs = submodule update --init --recursive

  # push everything including tags to default remote
  pt = !git push && git push --tags

  # push current branch to origin, tracking it
  pc = !git push -u origin $(git rev-parse --abbrev-ref HEAD)

  # push branch to several remotes
  ptr = "!f() { \
    for remote in "$@"; do git push "$remote"; done \
  }; f"

  # push branch and tags to several remotes
  pttt = "!f() { \
    for remote in "$@"; do git push "$remote" && git push --tags "$remote"; done \
  }; f"

  cob = checkout -b

  # save work as it goes, see 'undo' to use in tandem
  save = !git add -A && git commit -m 'SAVEPOINT'
  # same as 'aacm'
  savem = !git add -A && git commit -m
  wip = commit -am "WIP"
  svp = !git save && git push

  # reset to the previous commit, leaving changes in the work tree
  # this is useful in combination with aliases 'save' and 'wip'
  undo = reset HEAD~1 --mixed

  amend = commit -a --amend

  # commit, amend all - basically squash all current changes into the previous commit
  caa = commit -a --amend -C HEAD

  # a proper reset, that doesn't immediately make you loose everything
  # you can still retrieve the changes from reflog
  wipe = !git add -A && git commit -qm 'WIPE SAVEPOINT' && git reset HEAD~1 --hard

  # Delete a branch/tag both locally and remotely
  nuke-on = "!f() { \
      git push ${1} :$2; \
      git branch -d $2; \
      git tag -d $2; \
  }; f"

  f-nuke-on = "!f() { \
      git push ${1} :$2; \
      git branch -D $2; \
      git tag -d $2; \
  }; f"

  # delete all local branches that have been merged into master (or the
  # branch that you specify as the argument to this alias)
  # ${1-master} in shell script means: $1 (the 1st arguemnt) or default to 'master' if $1 not set
  bclean = "!f() { git checkout ${1-master} && git branch --merged ${1-master} | grep -v " ${1-master}$" | xargs git branch -d; }; f"
  bdone = "!f() { git checkout ${1-master} && git up && git bclean ${1-master}; }; f"
  bcleanest-dry = "!f() { git checkout ${1-master} && git branch --merged ${1-master} | grep -v " ${1-master}$" | xargs -I{} echo "git nuke {}"; }; f"
  bcleanest = "!f() { git checkout ${1-master} && git branch --merged ${1-master} | grep -v " ${1-master}$" | xargs -I{} git nuke {}; }; f"

  # Delete tags matching pattern both locally and remotely. $1 - remote, $2 - pattern
  # nuke-tags-on = "!f() { \
  #     git push -d $; \
  #     git branch -d $2; \
  #     git tag -d $2; \
  # }; f"

  # Delete a tag both locally and remotely (by default on Origin)
  nuke = "!f() { \
      git push origin --delete "$@"; \
      git branch -d "$@"; \
      git tag -d "$@"; \
  }; f"

  fnuke = "!f() { \
      git push origin --delete "$@"; \
      git branch -D "$@"; \
      git tag -d "$@"; \
  }; f"
  nukenuke = "!f() { \
      git push origin --delete "$@"; \
      git branch -D "$@"; \
      git tag -d "$@"; \
  }; f"

  # same as 'nuke'
  nuke-on-origin = "!f() { \
      git push origin --delete "$@"; \
      git branch -d "$@"; \
      git tag -d "$@"; \
  }; f"

  # 'fast-forward tracking' branches except for the checked out one, for this use `git pull --ff-only` or just `ff`
  fft = !sh -c 'git branch --format \"%(if)%(upstream:short)%(then)git push . %(upstream:short):%(refname:short)%(end)\" | sh' -
  ff = pull --ff-only

  # shows branches that are not present on remote named origin
  list-local = !git branch -r | awk '{print $1}' | egrep -v -f /dev/fd/0 <(git branch -vv | grep origin) | awk '{print $1}'


  # show name of current branch (without refs/heads/ prefix)
  # git rev-parse --abbrev-ref HEAD
  cur-bname = branch --show-current

  # show full current ref name (like refs/heads/master)
  cur-rname = symbolic-ref HEAD
